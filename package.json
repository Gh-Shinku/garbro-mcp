{
	"name": "garbro-mcp",
	"version": "0.0.0",
	"private": true,
	"description": "Modern TypeScript toolkit for detecting and extracting ADV/Galgame resource archives",
	"packageManager": "pnpm@11.26.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsc -b",
		"build:release": "pnpm build && node scripts/build-release.mjs",
		"test:release": "node scripts/test-release.mjs",
		"clean": "tsc -b --clean",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"inventory:garbro": "node scripts/generate-garbro-inventory.mjs",
		"catalog:formats": "node scripts/generate-format-support.mjs",
		"gap:garbro": "node scripts/garbro-gap.mjs",
		"targets:garbro": "node scripts/generate-test-data-targets.mjs",
		"typecheck": "tsc -b && tsc -p tsconfig.tests.json",
		"test": "pnpm build && vitest run",
		"test:differential": "pnpm build && node scripts/differential-archive.mjs",
		"check": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@garbro-mcp/codecs": "workspace:*",
		"@garbro-mcp/core": "workspace:*",
		"@garbro-mcp/formats": "workspace:*",
		"@garbro-mcp/mcp": "workspace:*",
		"@garbro-mcp/semantic": "workspace:*",
		"@modelcontextprotocol/client": "^2.0.0",
		"@types/node": "^24.13.4",
		"cross-spawn": "7.0.6",
		"esbuild": "0.28.2",
		"fflate": "0.8.3",
		"iconv-lite": "^0.7.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
